{
  "name": "dsh-wait-subagent",
  "version": "1.0.0",
  "description": "Active wait for background continuable subagents in DeepSeek Harness: registers a wait_subagent tool that blocks until the named subagent settles, then returns its stop reason and closing message — closing the gap between run_in_background fire-and-return and the async settlement notice. dsh-wait-subagent：为 DeepSeek Harness 提供后台 continuable 子代理的主动等待——注册 wait_subagent 工具阻塞至目标子代理收尾，返回停止原因与收尾消息，补齐后台子代理只能被动等通知的缺口。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "release": "npm version patch && npm pack --pack-destination /tmp"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "subagent",
    "agent",
    "background",
    "wait",
    "settlement",
    "continuable",
    "parallel",
    "子代理",
    "后台任务",
    "等待",
    "并行",
    "收尾消息",
    "智能体"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "author": "johnnren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/john-walks-slow/dsh-wait-subagent.git"
  },
  "homepage": "https://github.com/john-walks-slow/dsh-wait-subagent#readme",
  "bugs": {
    "url": "https://github.com/john-walks-slow/dsh-wait-subagent/issues"
  }
}
